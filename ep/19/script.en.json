      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "十月。梨ヶ坂市役所・地下。",
          "en": "October. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "アジア大会の閉会式、売れ行きが六割未満だそうです",
          "en": "Ticket sales for the Asian Games closing ceremony are apparently under sixty percent"
        },
        {
          "id": "p1-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "ボランティアを、交流のために招待するそうです",
          "en": "They're inviting volunteers, for \"exchange\""
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "タダで閉会式!? おれもボランティアやる!!",
          "en": "A free closing ceremony!? I'll volunteer too!!"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "今からなれるわけないでしょ!!",
          "en": "You can't become one now!!"
        },
        {
          "id": "p1-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "テツさんは席を埋めてません。五つ、つぶしてます",
          "en": "Tetsu doesn't fill seats. He's broken five"
        }
      ]
    },
