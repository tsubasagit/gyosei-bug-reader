      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "どうやって埋めるのよ!!",
          "en": "How are we supposed to fill them!!"
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "『二階席三百を、当日までに埋めること』……",
          "en": "\"Fill the 300 second-floor seats by the day of\"..."
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "埋めろ、としか書いてねえ!!",
          "en": "It just says fill!!"
        },
        {
          "id": "p5-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "人で、とは書いてねえ!!",
          "en": "It doesn't say with people!!"
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……そうかしら。氷室が、垂れ幕……",
          "en": "...Is that so? Himuro, holding the banner..."
        },
        {
          "id": "p5-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "一席十円なら、乗ります。テツさん持ちで",
          "en": "Ten yen a seat, and I'm in. Tetsu pays"
        },
        {
          "id": "p5-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "準備？ いらねえ。現場で寝る",
          "en": "Prep? Don't need it. I'll sleep at the venue"
        }
      ]
    },
