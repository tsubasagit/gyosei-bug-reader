      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "なんで地下が!!",
          "en": "Why the basement!!"
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "一階の七百で手いっぱいなの。部長の判つきよ",
          "en": "We're stretched with the 700 on the first floor. The director's seal is on it"
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "承知しました",
          "en": "Understood"
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "課長ォ!?",
          "en": "Chief!?"
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "運動会は、まぐれ。あなたたちは、椅子五つが限界ね",
          "en": "The sports day was a fluke. Five chairs is your limit"
        },
        {
          "id": "p3-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "勝負だ、前髪定規!!",
          "en": "You're on, Ruler Bangs!!"
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "負けたほうが、相手の課の前で",
          "en": "The loser stands in front of the other's section"
        },
        {
          "id": "p3-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "『満員御礼』の垂れ幕を持って立つ",
          "en": "holding a \"Full House\" banner",
          "note": "Man'in onrei (\"thank you for the full house\") is the banner hung out when every seat is sold, as at sumo tournaments. Here, the loser has to hold it up as a joke."
        },
        {
          "id": "p3-5-3",
          "panel": 5,
          "type": "speech",
          "ja": "開会は、明日の十時よ",
          "en": "The ceremony starts tomorrow at ten"
        },
        {
          "id": "p3-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "明日ァ!?",
          "en": "Tomorrow!?"
        },
        {
          "id": "p3-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "明日ですね",
          "en": "Tomorrow, yes"
        }
      ]
    },
