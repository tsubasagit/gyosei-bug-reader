      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "げっ!! 運動会の、前髪定規!!",
          "en": "Ugh!! The Ruler Bangs from the sports day!!"
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "氷室よ。前髪は関係ないわ",
          "en": "It's Himuro. My bangs have nothing to do with it"
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "くま、ありますね。角部屋ですか",
          "en": "You've got dark circles. Corner room?"
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "……市長が、毎時間のぞきに来るのよ",
          "en": "...The mayor peeks in every hour"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "明日の市制記念式典。二階席三百、地下で埋めてちょうだい",
          "en": "Tomorrow's city anniversary ceremony. Fill the 300 second-floor seats with the basement"
        },
        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "空席が写ったら、あなたたちの責任よ",
          "en": "If empty seats show up in the photo, it's on you"
        }
      ]
    },
