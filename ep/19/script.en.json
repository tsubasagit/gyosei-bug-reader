      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "申し込み、二階席ぶんはゼロです",
          "en": "Sign-ups for the second-floor seats: zero"
        },
        {
          "id": "p4-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "案内は、広報紙の隅に三行",
          "en": "The notice was three lines in a corner of the city newsletter"
        },
        {
          "id": "p4-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "土曜の朝十時。あいさつが七人……",
          "en": "Saturday, ten a.m. Seven speakers..."
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "むにゃ……あいさつのほうが、客より多いじゃねえか……",
          "en": "Mumble... more speakers than audience..."
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "どこも留守電!! なんで誰も来ないのよ!?",
          "en": "Voicemail everywhere!! Why won't anyone come!?"
        },
        {
          "id": "p4-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "市民には、式典に来る理由がありません",
          "en": "Citizens have no reason to attend a ceremony"
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "5階の若いの。盆踊りの練習、見に来てね",
          "en": "Kid from the fifth floor. Come see our Bon dance practice",
          "note": "Bon odori is the traditional summer folk dance, held around a raised stage. The seniors' club has been practicing but has no audience."
        },
        {
          "id": "p4-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "見せる人が、いないのよ",
          "en": "We've got no one to show it to"
        },
        {
          "id": "p4-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "むにゃ……踊りなんか見に行かねえ……パス",
          "en": "Mumble... I'm not watching dancing... pass"
        },
        {
          "id": "p4-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "はい、部長。一階は必ず……",
          "en": "Yes, Director. The first floor will definitely be..."
        }
      ]
    },
