      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "十月。梨ヶ坂市役所・地下。",
          "en": "October. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "本庁の産業課から、視察をひとつ……",
          "en": "The main building's Industry Division wants an inspection visit..."
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "愛媛県、新居浜市の工場です",
          "en": "A factory in Niihama City, Ehime."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "出張ォォ!!　行きます!!",
          "en": "A business trip!! I'm going!!"
        },
        {
          "id": "p1-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "視察＝見るだけ＝旅行!!",
          "en": "Inspection = looking = vacation!!"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "視察レポート……本庁に名前が残る!!",
          "en": "An inspection report... my name gets known at the main building!!"
        },
        {
          "id": "p1-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "僕は学校なので留守番です。時給で",
          "en": "I've got school, so I'll hold the fort. Paid hourly."
        },
        {
          "id": "p1-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "私は同じ週に有給を。お遍路の続きです",
          "en": "I'm taking paid leave that week. More of my pilgrimage."
        }
      ]
    },
