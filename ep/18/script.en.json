          "panel": 2,
          "type": "speech",
          "ja": "……他人が、書く？",
          "en": "...Someone else writes it?"
        },
        {
          "id": "p9-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "人生の最初と最後は、他人が書くんだろ!!",
          "en": "The start and end of your life are written by other people!!"
        },
        {
          "id": "p9-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "間くらい、おれが書いて何が悪い!!",
          "en": "So what's wrong with me writing the middle!!"
        },
        {
          "id": "p9-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……そうかしら",
          "en": "...Is that so?"
        },
        {
          "id": "p9-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "書く時間がなくなれば、待ちは三分の一です",
          "en": "No writing time means one-third the wait"
        },
        {
          "id": "p9-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "だろ!?",
          "en": "Right!?"
        }
