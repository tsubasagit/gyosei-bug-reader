      "lines": [
        {
          "id": "p8-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "本籍は、地番があれば日本中どこでも置けます",
          "en": "You can place your honseki anywhere in Japan, as long as it has a lot number",
          "note": "Under the Family Register Act, a honseki can be moved to any address with an official lot number by filing a transfer notice (tenseki todoke). Filing is free."
        },
        {
          "id": "p8-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "届けは、無料",
          "en": "And filing is free"
        },
        {
          "id": "p8-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……どこでも？",
          "en": "...Anywhere?"
        },
        {
          "id": "p8-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "生まれは引き直せねえ。だが本籍なら引き直せる!!",
          "en": "You can't reroll your birth. But you CAN reroll your honseki!!"
        }
      ]
    },
