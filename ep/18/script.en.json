      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "それ、何回目？",
          "en": "How many tries is that?"
        },
        {
          "id": "p4-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "……三十八回目",
          "en": "...Thirty-eight"
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "すまんな、若いの。孫が邪魔した",
          "en": "Sorry, young fella. My grandson's in your way"
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "孫に聞かれてな。じいちゃんの人生って、どんなのって",
          "en": "He asked me what Grandpa's life was like"
        },
        {
          "id": "p4-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "なら、紙で見せてやろうと思ってな",
          "en": "So I figured I'd show him on paper"
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……いいですね",
          "en": "...That's nice"
        },
        {
          "id": "p4-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "じいちゃん、八十億回やっても、たぶん体操の先生",
          "en": "Grandpa, even in 8 billion rolls, you'd be a gym teacher"
        },
        {
          "id": "p4-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "ガチャ、要らねえじゃん",
          "en": "Who needs gacha, then"
        }
      ]
    },
