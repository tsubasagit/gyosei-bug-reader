      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "2026年10月。",
          "en": "October 2026."
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "人生シミュレーター『80億分の1』が大流行。",
          "en": "The life simulator \"1 in 8 Billion\" is all the rage.",
          "note": "A browser game released in October 2026 that rolls you a random birth among the world's 8 billion people (country and sex)."
        },
        {
          "id": "p1-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "もう一回!! 次こそ石油王の家!!",
          "en": "One more!! This time, an oil sheikh's family!!"
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "日本・男性……この地味さは、公務員だ",
          "en": "Japan, male... this blandness says civil servant"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "現実と同じじゃねえか!!",
          "en": "That's just my actual life!!"
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "勤務中に、人生を引き直すな",
          "en": "Don't reroll your life on the clock"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "僕は、時給で見守ってます",
          "en": "I'm watching over you. By the hour"
        },
        {
          "id": "p1-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "今日も、いい枝ぶりです",
          "en": "Lovely branches today"
        }
      ]
    },
