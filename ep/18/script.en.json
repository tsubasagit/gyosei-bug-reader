      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "市民課が、九十分待ちだそうです",
          "en": "The Residents Section has a ninety-minute wait"
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "応援に、参りましょう",
          "en": "Let's go lend a hand"
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "私は、奥で証明書の照合を",
          "en": "I'll check certificates in the back"
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "やだやだ、窓口は人が多い",
          "en": "Ugh, no. The counter's full of people"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……待合で、スマホいじってていいなら",
          "en": "...If I can play on my phone in the waiting area"
        },
        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "条件つけるな",
          "en": "No conditions"
        }
      ]
    },
