      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "ホールの中で、傘ァ!?",
          "en": "Umbrellas INSIDE the hall?!"
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "来月の発表会も、このままじゃ……",
          "en": "At this rate, next month's concert..."
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "予算にない修繕は、すぐには……",
          "en": "Repairs that aren't in the budget can't happen fast..."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "直しましょう……必ず……!!",
          "en": "We'll fix it... I promise...!!"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……財源は、ありません",
          "en": "...We have no money for it."
        }
      ]
    },
