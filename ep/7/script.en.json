      "lines": [
        {
          "id": "p8-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "庁舎じゅうに、企業名のプレートが並んだ。",
          "en": "Company name plates went up all over City Hall."
        },
        {
          "id": "p8-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "こ、こんなものまで……!?",
          "en": "E-even on THIS...?!"
        },
        {
          "id": "p8-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "……でも実績、三十件……!",
          "en": "...Still, thirty deals...!"
        },
        {
          "id": "p8-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "張り紙より、プレートのほうが多い……",
          "en": "There are more plates than notices..."
        },
        {
          "id": "p8-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "……窓口の番号、どこ行った……?",
          "en": "...Where'd the counter numbers go...?"
        },
        {
          "id": "p8-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "発表会が、できる……!!",
          "en": "We can hold our concert...!!"
        },
        {
          "id": "p8-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "手数料も、ウハウハだァ!!",
          "en": "And the fees are rolling in!!"
        }
      ]
    },
