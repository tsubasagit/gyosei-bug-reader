      "lines": [
        {
          "id": "p10-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "丸々製作所前で、人が倒れてます!!",
          "en": "A man's collapsed at Marumaru Works Front!!"
        },
        {
          "id": "p10-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "その呼び名では、特定できません!!",
          "en": "We can't locate a place by that name!!"
        },
        {
          "id": "p10-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "住所は、分かりますか!?",
          "en": "Do you know the address?!"
        },
        {
          "id": "p10-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "ここ、名前が四つある……!!",
          "en": "This spot has FOUR names...!!",
          "note": "The signs read “Midori Plaza,” “Kibo-no-Oka (Hope Hill)” and “Smile Terrace” — plus the new “Marumaru Works Front.”"
        },
        {
          "id": "p10-4-1",
          "panel": 4,
          "type": "caption",
          "ja": "救急車は、場所を探して回り続けた。",
          "en": "The ambulance kept circling, searching for the spot."
        }
      ]
    },
