      "lines": [
        {
          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "うおおお!! 条例、全部読んでやらァ!!",
          "en": "Raaagh!! I'll read EVERY ordinance!!"
        },
        {
          "id": "p6-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "――その夜。",
          "en": "—That night."
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "施設の名前は、条例で決まってる……!!",
          "en": "Facility names are set by ordinance...!!",
          "note": "The official name of a public facility is written into a city ordinance, so only a council vote can change it. That's why cities sell “nicknames” instead."
        },
        {
          "id": "p6-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "勝手には、変えられねえ……!!",
          "en": "Can't just change 'em...!!"
        },
        {
          "id": "p6-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "待てよ……条例にない「愛称」なら？",
          "en": "Wait... what about a “nickname” the ordinance doesn't cover?"
        },
        {
          "id": "p6-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "――見つけたァ!! 愛称なら売れる!!",
          "en": "—FOUND IT!! Nicknames, I can sell!!"
        },
        {
          "id": "p6-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "愛称なんざ、いくつ付けても誰も困らねえ!!",
          "en": "Slap on as many nicknames as you like — who's it gonna hurt!!"
        }
      ]
    },
