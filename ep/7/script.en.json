      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "命名料は、改修費に!!",
          "en": "Naming fees go to the repairs!!"
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "仲介の手数料は、おれの懐に!!",
          "en": "The broker's fee goes in MY pocket!!"
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "歩合がないなら、定時で帰ります",
          "en": "No commission? Then I clock out on time."
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "市の施設の名前を、勝手に売るな!!",
          "en": "You can't just sell off the names of city facilities!!"
        },
        {
          "id": "p5-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "……でも、梨ヶ坂初の実績……",
          "en": "...But a Nashigasaka first..."
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "なら、売っていい名前を探してやらァ!!",
          "en": "Then I'll find names I CAN sell!!"
        },
        {
          "id": "p5-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "では、定時なのでお先に",
          "en": "Well, it's quitting time. See you."
        }
      ]
    },
