      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "課長、金がないなら、約束しないで下さいよ",
          "en": "Chief, don't make promises if there's no money!"
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "課長、ノープランですね",
          "en": "Chief, you have no plan."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "財源なら、ネーミングライツよ!!",
          "en": "Need money? Naming rights!!",
          "note": "Many Japanese cities sell sponsors the right to name stadiums and halls for a fixed term and yearly fee."
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "名前を企業に売って、その収入で直すの!!",
          "en": "Sell the name to a company, and that pays for the repairs!!"
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "梨ヶ坂はやってるんですか？",
          "en": "Does Nashigasaka do that?"
        },
        {
          "id": "p3-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "まだよ!! だから梨ヶ坂初の大手柄!!",
          "en": "Not yet!! So it'd be Nashigasaka's first big win!!"
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "名前に……金を払う……!?",
          "en": "People pay money... for a NAME...?!"
        }
      ]
    },
