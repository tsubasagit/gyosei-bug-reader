      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "名前のついてねえもの……",
          "en": "Stuff nobody's named yet..."
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "階段!!",
          "en": "STAIRS!!"
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "トイレ!!",
          "en": "TOILETS!!"
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "ベンチ!!",
          "en": "BENCHES!!"
        },
        {
          "id": "p4-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "全部、売れるじゃねえかァァ!!",
          "en": "I can sell ALL of it!!"
        }
      ]
    },
