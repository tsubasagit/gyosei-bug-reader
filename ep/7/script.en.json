      "lines": [
        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "その日から、テツは梨ヶ坂中の会社を駆け回った。",
          "en": "From that day on, Tetsu raced to every company in Nashigasaka."
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "階段に、御社の名前を!!",
          "en": "Your company's name — on the stairs!!"
        },
        {
          "id": "p7-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "階段か……買ったァ!!",
          "en": "Stairs, eh... SOLD!!"
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "ベンチに、パン屋の名前を!!",
          "en": "Your bakery's name — on a bench!!"
        },
        {
          "id": "p7-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "座るたびにパンを思い出す……買った!!",
          "en": "Sit down, think bread... SOLD!!"
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "トイレに、梨の名前を!!",
          "en": "Your orchard's name — on the toilets!!"
        },
        {
          "id": "p7-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "ト、トイレ……ええい、買ったァ!!",
          "en": "T-toilets... ugh, fine, SOLD!!"
        },
        {
          "id": "p7-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "ご契約、ありがとうございますッ!!",
          "en": "Thank you for your business!!"
        },
        {
          "id": "p7-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "今日だけで、三十件……",
          "en": "Thirty deals today alone..."
        },
        {
          "id": "p7-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "……一体どうやって、契約を結んでるんだ……",
          "en": "...How is he even closing these...?"
        }
      ]
    },
