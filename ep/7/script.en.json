      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "雨の日は外回りなし……天国だぜ〜",
          "en": "Rainy day, no field work... this is heaven~"
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "勤務中に寝るなァ!!",
          "en": "No sleeping on the job!!"
        },
        {
          "id": "p1-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "雨でも時給は同じです",
          "en": "Rain or shine, same hourly rate."
        },
        {
          "id": "p1-1-4",
          "panel": 1,
          "type": "caption",
          "ja": "秋の長雨。梨ヶ坂市役所・地下。",
          "en": "Autumn rains. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "私が毎年聴いている、合唱団の方です……",
          "en": "She's from the choir I go to hear every year..."
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "四十年歌ってきたホールが、雨漏りで……",
          "en": "The hall we've sung in for forty years... it leaks..."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "な、なんだァ!?",
          "en": "Wh-what the—?!"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "天井が、しみだらけ……!?",
          "en": "The ceiling's all stained...?!"
        }
      ]
    },
    {
      "page": 2,
      "panels": {
