      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "十一月。梨ヶ坂市役所は、冷たい雨。",
          "en": "November. Cold rain over Nashigasaka City Hall."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "いい傘だ。木の柄は、手になじむな",
          "en": "Nice umbrella. A wooden handle sits right in the hand."
        },
        {
          "id": "p1-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "……それ、だれの傘？",
          "en": "...Whose umbrella is that?"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "知らねえ。傘立ての、いちばんいいやつ",
          "en": "Dunno. The best one in the umbrella stand."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "それを泥棒って言うのよ!!",
          "en": "That is called stealing!!"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "借りただけだ。傘は天下の回りものだ",
          "en": "I only borrowed it. Umbrellas go around, like they say.",
          "note": "A twist on the Japanese proverb \"money goes around in the world\" (kane wa tenka no mawarimono)."
        },
        {
          "id": "p1-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "それ、お金の話です",
          "en": "That saying is about money."
        }
      ]
    },
