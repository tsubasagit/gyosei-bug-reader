      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "総務課です。傘の取り違え、対策を",
          "en": "General Affairs. We need a fix for the umbrella mix-ups."
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "今月、三十件。バツです",
          "en": "Thirty this month. That is a fail.",
          "note": "Ms. Kinugawa of General Affairs grades everything with a circle (pass), a cross (fail), or a triangle (half marks), the marks used on Japanese school tests."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "あ……ぼくの傘",
          "en": "Ah... my umbrella."
        },
        {
          "id": "p2-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "…………",
          "en": ".........."
        },
        {
          "id": "p2-3-3",
          "panel": 3,
          "type": "speech",
          "ja": "三十一件目。バツ",
          "en": "No. 31. Fail."
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "返しなさい!!",
          "en": "Give it back!!"
        },
        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "借りただけだって",
          "en": "I said I only borrowed it."
        },
        {
          "id": "p2-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "特務トレンド係で、お預かりします",
          "en": "The Special Trends Unit will take this one on."
        }
      ]
    },
