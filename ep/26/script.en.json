        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "母が、就職祝いにくれた傘で",
          "en": "My mother gave me this umbrella when I got the job."
        },
        {
          "id": "p4-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "なくしたら、顔向けできません",
          "en": "If I lost it, I could not face her."
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "…………",
          "en": ".........."
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "付けとけ。これなら、おれでも間違えねえ",
          "en": "Keep it on. Now even I cannot mix it up."
        },
        {
          "id": "p4-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "ありがとうございます!!",
          "en": "Thank you so much!!"
        },
        {
          "id": "p4-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "泣かれると、うるせえからだ!!",
          "en": "I just hate the noise when people cry!!"
        }
      ]
    },
