      "lines": [
        {
          "id": "p10-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "取り違えの届け、ゼロ件。マルです",
          "en": "Mix-up reports: zero. That is a pass."
        },
        {
          "id": "p10-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "梨が付いてるから、どれでもいいのよね",
          "en": "They all have a pear, so any one will do, right?"
        },
        {
          "id": "p10-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "三日後。",
          "en": "Three days later."
        },
        {
          "id": "p10-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "見たか、赤嶺!!",
          "en": "See that, Akamine!!"
        },
        {
          "id": "p10-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "数字で負けるのが、腹立つ……!",
          "en": "Losing to him on numbers makes me so mad...!"
        },
        {
          "id": "p10-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "レナさんも、付けてますね",
          "en": "You put one on yours too, Rena."
        },
        {
          "id": "p10-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "い、一万二千円の傘なのよ",
          "en": "I-it is a 12,000-yen umbrella."
        },
        {
          "id": "p10-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "念のため。念のためよ",
          "en": "Just in case. Just in case!"
        },
        {
          "id": "p10-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "湯のみにも付けたい",
          "en": "I want one for my teacup too."
        },
        {
          "id": "p10-6-1",
