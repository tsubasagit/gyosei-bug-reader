          "id": "p8-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "毎度! 梨ヶ坂の目印、三百円!!",
          "en": "Thanks! The Nashigasaka marker, 300 yen!!"
        },
        {
          "id": "p8-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "もう六十個です",
          "en": "That makes sixty sold."
        },
        {
          "id": "p8-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "……ちょっと",
          "en": "...Wait a second."
        },
        {
          "id": "p8-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "全部、同じ梨じゃない",
          "en": "They are all the same pear."
        },
        {
          "id": "p8-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "同じじゃ、目印にならないでしょ!!",
          "en": "If they are all the same, they mark nothing!!"
        },
        {
          "id": "p8-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "梨が付いてりゃ、職員の傘",
          "en": "Got a pear? It is a staff umbrella."
        },
        {
          "id": "p8-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "なけりゃ、客の傘だ",
          "en": "No pear? It is a visitor's."
        }
      ]
    },
