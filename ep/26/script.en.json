      "lines": [
        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "去年の梨まつりの余りだ",
          "en": "Leftovers from last year's Pear Festival."
        },
        {
          "id": "p7-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "捨てろって言われた、三百個",
          "en": "Three hundred of them. I was told to throw them out."
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "流行ってますよ、目印チャーム",
          "en": "Marker charms are a big trend, you know.",
          "note": "Small charms tied to umbrellas and bottles so that you can tell yours apart. In the story they top this year's hit-product ranking."
        },
        {
          "id": "p7-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "今年のヒット商品、一位です",
          "en": "Number one hit product of the year."
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "一個三百円。元手はゼロ!!",
          "en": "300 yen each. Zero cost to me!!"
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "僕の歩合は",
          "en": "My commission is..."
        },
        {
          "id": "p7-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "十円",
          "en": "Ten yen."
        },
        {
          "id": "p7-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "二十",
          "en": "Twenty."
        },
        {
          "id": "p7-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "……十五",
          "en": "...Fifteen."
        },
        {
          "id": "p7-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "待ちなさい!! 庁内で商売なんて",
          "en": "Stop right there!! No selling things inside City Hall!"
        },
        {
          "id": "p7-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "取り違えが減るなら、マルです",
          "en": "If the mix-ups go down, that is a pass."
        },
        {
          "id": "p7-7-1",
          "panel": 7,
          "type": "speech",
          "ja": "……マル、なの？",
          "en": "...It is a pass?"
        }
      ]
    },
