      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "解決よ!!",
          "en": "Solved!!"
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "名前を書けば、取り違えはゼロ",
          "en": "Write your name on it, and mix-ups drop to zero."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "書きませんよ、大人は",
          "en": "Grown-ups will not write it."
        },
        {
          "id": "p3-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "恥ずかしいので",
          "en": "Too embarrassing."
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "私は、書きますが",
          "en": "I do write mine."
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "小学生かよ",
          "en": "What are you, a schoolkid?"
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "母の教えでして",
          "en": "My mother taught me to."
        },
        {
          "id": "p3-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "……課長しか、書いてない",
          "en": "...Only the chief has written his."
        },
        {
          "id": "p3-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "貼り紙。サンカクです",
          "en": "The poster. Half marks."
        }
      ]
    },
