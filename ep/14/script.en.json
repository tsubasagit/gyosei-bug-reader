      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "梨の花の、咲いた日をね",
          "en": "The day the pear blossoms open..."
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "四十二年、毎年つけてきました",
          "en": "Every year for 42 years."
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……これ、全部ノートか!?",
          "en": "...These are ALL notebooks!?"
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "研究は、何十年もかけるもの",
          "en": "Research takes decades."
        },
        {
          "id": "p5-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "受賞も、二十年、三十年あとが多い",
          "en": "Prizes often come 20, 30 years later."
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……継ぐ人は、おりませんがね",
          "en": "...Nobody to carry it on, though."
        },
        {
          "id": "p5-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "四十二年で、感謝状一枚!?",
          "en": "42 years, and ONE thank-you letter!?"
        },
        {
          "id": "p5-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "地味ィ!!",
          "en": "BORING!!"
        }
      ]
