        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "ゆかりの条件、その一!! 乗り換えた!!",
          "en": "Rule one of ties!! Changed trains here!!"
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "その二、梨を食った!! その三、ボールペン!!",
          "en": "Two: ate a pear!! Three: used our ballpoint pen!!"
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "当てはめると……ほぼ全員です",
