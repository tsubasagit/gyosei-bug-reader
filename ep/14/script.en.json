      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "受賞が決まるとね、出身の町や母校の町が",
          "en": "When a prize is announced, the winner's hometown and alma mater...",
          "note": "When a Japanese scientist wins a Nobel Prize, their birthplace, old school and workplace race to hang huge congratulation banners on city hall and claim them as \"a person with ties to our town\" (yukari no hito)."
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "確かめてから、庁舎に懸垂幕を下げるの",
          "en": "...check the facts, then hang a banner on City Hall."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "梨ヶ坂の出身、母校、勤め先",
          "en": "Born, studied, or worked in Nashigasaka..."
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "……ゆかりの研究者、ゼロ件です",
          "en": "...Researchers with ties here: zero."
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "地元の大学にも、いないのね……",
          "en": "Not even at the local university..."
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "……いや待て!! いるぞ!!",
          "en": "...No, wait!! There IS one!!"
        },
        {
          "id": "p3-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "うちの団地の一階に、大学の先生が",
          "en": "There's a professor on the ground floor of my building!"
        }
      ]
    },
