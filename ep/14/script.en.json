      "lines": [
        {
          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "梨ヶ坂は昔、街道の宿場でね",
          "en": "Long ago, Nashigasaka was a post town.",
          "note": "A post town (shukuba) was a rest stop on Japan's old highways, where travelers stayed overnight."
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "通っていった人も、みんな",
          "en": "Everyone who passed through..."
        },
        {
          "id": "p6-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "この町の、ゆかりの人ですよ",
          "en": "...has ties to this town, you see."
        },
        {
          "id": "p6-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "……通った人は、みんな？",
          "en": "...Everyone who passed through?"
        },
        {
          "id": "p6-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "通っただけで、ゆかり!!",
          "en": "Just passing through counts!!"
        },
        {
          "id": "p6-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "梨ヶ坂駅で乗り換えたやつも、ゆかりだァ!!",
          "en": "Changed trains at Nashigasaka Station? You've got TIES!!"
        },
        {
          "id": "p6-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "……おや？",
          "en": "...Oh?"
        }
      ]
    },
