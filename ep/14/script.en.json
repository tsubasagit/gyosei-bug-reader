      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "ノーベル賞!? 賞金いくらだ!!",
          "en": "A Nobel Prize!? How much is the prize money!!"
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "十月。梨ヶ坂市役所・地下。",
          "en": "October. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "賞金は、一億円を超えます",
          "en": "The prize is over 100 million yen."
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "おれも取る!!",
          "en": "I'm winning one too!!"
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……何の研究で？",
          "en": "...For what research?"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "発表は、日本時間の夕方から夜",
          "en": "Announced evenings, Japan time."
        },
        {
          "id": "p1-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "来週の月曜から、平日に一つずつ",
          "en": "One per weekday, starting next Monday."
        }
      ]
    },
