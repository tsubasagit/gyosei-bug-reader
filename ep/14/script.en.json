        },
        {
          "id": "p4-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "ノーベル賞の知り合い、いねえか!!",
          "en": "Know any Nobel winners!?"
        },
        {
          "id": "p4-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "……おらんなあ",
          "en": "...Can't say I do."
        }
      ]
