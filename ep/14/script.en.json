      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "本庁の、秘書課からです",
          "en": "From the Mayor's staff, main building."
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……断れませんでした",
          "en": "...I couldn't say no."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "垂れ幕……予算は？",
          "en": "Banners... and the budget?"
        },
        {
          "id": "p2-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "古い横断幕の、裏を使ってくださいと",
          "en": "Use the backs of old banners, they said."
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "どこよりも、早く……？",
          "en": "Before anyone else...?"
        },
        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "一番乗りなら、テレビが来るぜ!!",
          "en": "Be first, and the TV crews come!!"
        }
      ]
    },
