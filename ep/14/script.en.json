      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "五階の若いの、おかえり。回覧板",
          "en": "Welcome home, Fifth Floor. Neighborhood notice."
        },
        {
          "id": "p4-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "尾根平団地。テツの住まい。",
          "en": "Onedaira Housing Estate. Where Tetsu lives."
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "じいさん、大学の先生だったよな",
          "en": "Gramps, you were a university professor, right?"
        },
