          "panel": 3,
          "type": "speech",
          "ja": "推薦の中身は、50年間、非公開です",
          "en": "Nominations stay secret for 50 years."
        },
        {
          "id": "p7-3-3",
          "panel": 3,
          "type": "speech",
          "ja": "予想記事の候補は、四十一人。全部、予想ですね",
          "en": "Predicted winners: 41. All guesses."
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "なら、予想を全部祝え!!",
          "en": "Then celebrate EVERY guess!!"
        },
        {
          "id": "p7-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "……そうかしら",
          "en": "...Would that work?"
        }
      ]
