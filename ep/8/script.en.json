      "lines": [
        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "出店料の半分は、あんたにお礼しよう",
          "en": "I'll give you half the stall fees as thanks."
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "…………半分？",
          "en": "............ Half?"
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "一区画二万、三十区画で六十万――",
          "en": "20,000 a plot, thirty plots, 600,000—"
        },
        {
          "id": "p7-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "半分で三十万!!",
          "en": "Half is 300,000!!"
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "僕の取り分は",
          "en": "And my cut?"
        },
        {
          "id": "p7-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "お礼って、公務員でしょ!?",
          "en": "Thanks!? You're a civil servant!!"
        }
      ]
    },
