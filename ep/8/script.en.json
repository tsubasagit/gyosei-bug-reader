      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "空き店舗が十四。夜の人通りは、十年で三分の一です",
          "en": "Fourteen empty shops. Night foot traffic's down two-thirds in ten years."
        },
        {
          "id": "p4-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "梨ヶ坂市・なしざか通り商店街。",
          "en": "Nashigasaka City: the Nashizaka-dori shopping street."
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "バスは坂を上って、坂上の団地へ行く",
          "en": "The bus climbs the hill to the housing estate up top."
        },
        {
          "id": "p4-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "夜は一時間に一本だ",
          "en": "At night, one an hour."
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "坂……長ェ……帰りてえ……",
          "en": "This hill... so long... wanna go home..."
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "まだ半分よ!!",
          "en": "We're only halfway!!"
        }
      ]
    },
