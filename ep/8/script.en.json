      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "勤務中に！　何を！　作ってるの!!",
          "en": "On the job!! What are you!! MAKING!!"
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "十月の下旬。梨ヶ坂市役所・地下。",
          "en": "Late October. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "ハロウィンの仮装だよ。『歩く札束』",
          "en": "My Halloween costume. \"Walking Wad of Cash.\""
        },
        {
          "id": "p1-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "縁起がいいだろ",
          "en": "Lucky, right?"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "渋谷、夜の路上飲酒は一年中ダメになったそうです",
          "en": "They say Shibuya banned street drinking at night, all year round.",
          "note": "Shibuya Ward made its nighttime ban on street drinking around the station a year-round rule."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "じゃあ今年はどこで騒ぎゃいいんだよォ!!",
          "en": "Then where am I supposed to party this year!?"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "……はい、特務トレンド係です",
          "en": "... Yes, Special Trends Unit."
        }
      ]
    },
    {
