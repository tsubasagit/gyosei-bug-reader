      "lines": [
        {
          "id": "p8-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "人を呼ぶには、目玉が要る……",
          "en": "To pull a crowd, we need a main attraction..."
        },
        {
          "id": "p8-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "仮装コンテスト!!　お題は『市役所の課長』だァ!!",
          "en": "A costume contest!! Theme: \"City Hall Section Chief\"!!"
        },
        {
          "id": "p8-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "段ボールの決裁印、一個五十円なら作ります",
          "en": "I'll make cardboard APPROVED stamps. 50 yen each."
        },
        {
          "id": "p8-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "若者の来訪者数……本庁に出せる数字……!!",
          "en": "Young visitor numbers... numbers I can show the main building...!!"
        },
        {
          "id": "p8-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "……？",
          "en": "...?"
        }
      ]
    },
