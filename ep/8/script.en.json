      "lines": [
        {
          "id": "p9-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "パレードは道交法77条……",
          "en": "A parade: Road Traffic Act, Article 77...",
          "note": "In Japan, a parade on a public road needs a road use permit from the local police chief (Road Traffic Act, Art. 77)."
        },
        {
          "id": "p9-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "警察署長の、道路使用許可……",
          "en": "A road use permit from the police chief..."
        },
        {
          "id": "p9-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "――その夜。",
          "en": "—That night."
        },
        {
          "id": "p9-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "屋台は道路法32条……市の、道路占用許可……",
          "en": "Stalls: Road Act, Art. 32... a city occupancy permit...",
          "note": "Stalls on a road need a separate road occupancy permit from the road's manager, here the city (Road Act, Art. 32)."
        },
        {
          "id": "p9-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "二つ要るのかよ!!",
          "en": "I need TWO!?"
        },
        {
          "id": "p9-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "人数、区域、時間……条件つきか……!!",
          "en": "Headcount, area, hours... it comes with conditions...!!"
        }
      ]
    },
