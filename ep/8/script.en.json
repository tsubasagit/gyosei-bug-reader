      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "商店街から、若者を呼べるハロウィンをと要望だ",
          "en": "The shopping street wants a Halloween that draws young people."
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "地下で頼む",
          "en": "Basement's job."
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "十月三十一日、土曜の夜だ。頼んだよ、豪徳寺くん",
          "en": "October 31st, Saturday night. I'm counting on you, Gotokuji."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "おれはいない、おれは札束……",
          "en": "I'm not here. I'm a wad of cash..."
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……承知いたしました",
          "en": "... Understood, sir."
        },
        {
          "id": "p2-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "源田くん。お客さまです",
          "en": "Genda. You have a visitor."
        },
        {
          "id": "p2-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "なんでバレたァ!?",
          "en": "How'd you know it was me!?"
        }
      ]
    },
