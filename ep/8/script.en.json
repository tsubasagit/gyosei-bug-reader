      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "坂上ちょうちん行列",
          "en": "The Sakaue Lantern Parade"
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "坂の下から上まで、ちょうちんが続いてな",
          "en": "Lanterns all the way from the bottom of the hill to the top."
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "caption",
          "ja": "三十年前の秋。",
          "en": "An autumn thirty years ago."
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "それきり、担い手がおらんようになってな",
          "en": "After that, nobody was left to run it."
        },
        {
          "id": "p5-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "ばあさんが最後まで、またやろうって言っとった",
          "en": "My wife kept saying we should do it again, till the very end."
        },
        {
          "id": "p5-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "この人数に屋台出したら、儲かったろうなァ",
          "en": "With a crowd like that, food stalls would've made a killing..."
        },
        {
          "id": "p5-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "そこじゃない!!",
          "en": "NOT the point!!"
        }
      ]
    },
