      "lines": [
        {
          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "イベント会社に頼めば――",
          "en": "If we hire an event company—"
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "十月末は全社埋まってます。渋谷の周りで",
          "en": "Late October, they're all booked. Around Shibuya."
        },
        {
          "id": "p6-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "補助金は――",
          "en": "A subsidy—"
        },
        {
          "id": "p6-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "締切は春です",
          "en": "The deadline was spring."
        },
        {
          "id": "p6-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "じゃあSNSで――",
          "en": "Then social media—"
        },
        {
          "id": "p6-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "商店街のアカウント、フォロワー十二人です",
          "en": "The street's account has twelve followers."
        },
        {
          "id": "p6-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "間に合わないじゃない!!",
          "en": "We'll never make it in time!!"
        }
      ]
    },
