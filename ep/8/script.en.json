      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "なしざか通り商店街の、大黒です",
          "en": "I'm Daikoku, from the shopping street."
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "坂の途中で金物屋をやっとります",
          "en": "I run the hardware store halfway up the hill."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "渋谷がダメなら、行き場のない若い子もおるでしょう",
          "en": "With Shibuya off-limits, some young folks must have nowhere to go."
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "うちの坂に呼べんかね",
          "en": "Couldn't we bring 'em to our hill?"
        },
        {
          "id": "p3-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "タダ働きの匂いしかしねえ",
          "en": "Smells like unpaid work."
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……あの坂にも、昔は人があふれたんだよ",
          "en": "... That hill was packed once, you know."
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "……断れない流れね、これ",
          "en": "... No way to say no to this one."
        }
      ]
    },
