      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "連合会から、毎月同じ原稿が届きます",
          "en": "Every month the federation sends us the same draft."
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "それを会長がめいめい、手で書き写すのです",
          "en": "And each chairman copies it out by hand."
        },
        {
          "id": "p5-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "翌日。",
          "en": "The next day."
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……中身、全部同じじゃない",
          "en": "...They're all exactly the same."
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "違うのは、町の名前と会長の名前だけですね",
          "en": "Only the town name and the chairman's name change."
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "一枚作って、名前だけ入れ替えりゃ……百二十枚、一瞬じゃねえか!!",
          "en": "Make one sheet, swap the names... 120 sheets in a flash!!"
        },
        {
          "id": "p5-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "それが、さっきの置換です",
          "en": "That's the “chikan” I meant."
        }
      ]
    },
