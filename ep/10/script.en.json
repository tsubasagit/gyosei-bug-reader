      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "毎月、三晩かけて書いております",
          "en": "Every month, I spend three nights writing it."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "ゴミの日、木曜ですか、本曜ですか",
          "en": "Is trash day “Thursday”... or “Thirstday”?"
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "前は、家内がワープロで打ってくれました",
          "en": "My wife used to type it up on her word processor."
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "十二月一日には、年末の防犯の回覧を出したいのです",
          "en": "On December 1st, I want to send out the year-end crime-watch notice."
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "……この字、暗号ですか？",
          "en": "...Is this written in code?"
        }
      ]
    },
