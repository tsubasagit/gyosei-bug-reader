      "lines": [
        {
          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "会長はみんな八十代。回覧、おれが作ってやる!!",
          "en": "The chairmen are all in their 80s. I'll make their circulars!!"
        },
        {
          "id": "p6-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "町内会から月三千円!!　百二十で月三十六万!!",
          "en": "¥3,000 a month each!! Times 120 is ¥360,000!!"
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "一町内会、百円で乗ります",
          "en": "I'm in. 100 yen per association."
        },
        {
          "id": "p6-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "ちょっと、公務員がお金を取るのは……",
          "en": "Wait, civil servants can't charge money..."
        },
        {
          "id": "p6-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "地域DX、百二十団体だぞ",
          "en": "It's local DX! 120 groups!"
        },
        {
          "id": "p6-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "百二十団体……本庁……",
          "en": "120 groups... main building..."
        }
      ]
