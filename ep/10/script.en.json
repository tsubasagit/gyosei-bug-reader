      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "梨ヶ坂市、坂上町。",
          "en": "Sakagami, Nashigasaka City."
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "この回覧板、九月の日付です",
          "en": "This circular is dated September."
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "あ、読んでない。回しとくね",
          "en": "Oh, haven't read it. I'll pass it on."
        },
        {
          "id": "p4-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "誰も、読まないのです",
          "en": "Nobody reads it."
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "火の用心",
          "en": "Beware of fire.",
          "note": "“Hi no yōjin” (beware of fire) is the traditional call of neighborhood night patrols in winter."
        },
        {
          "id": "p4-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "梨田のおじいちゃーん!",
          "en": "Mr. Nashidaaa!"
        },
        {
          "id": "p4-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "さ、坂が……",
          "en": "Th-this hill..."
        }
      ]
    },
