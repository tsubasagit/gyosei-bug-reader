      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "ここは置換で一発です",
          "en": "One “chikan” and done.",
          "note": "In Japanese, “chikan” (置換) means “find and replace” — but it sounds exactly like “chikan” (痴漢), a groper on a train. That pun drives this whole episode."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "ち、ちかん!?　おれはやってねえ!!",
          "en": "Ch-chikan!? I never touched anyone!!"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "置き換えの\"置換\"!!",
          "en": "“Chikan” as in REPLACE!!"
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "Ctrl＋H です",
          "en": "It's Ctrl+H."
        },
        {
          "id": "p1-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "……失礼します。回覧板を、お持ちしました",
          "en": "...Excuse me. I've brought the circular board."
        }
      ]
    },
