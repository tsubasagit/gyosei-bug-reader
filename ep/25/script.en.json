      "lines": [
        {
          "id": "p20-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "源田さんは、私の代わりがお好きなようですので",
          "en": "You seem to enjoy standing in for me, Genda-san."
        },
        {
          "id": "p20-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "私の代わりに、八十八か所へ。一番札所から、歩きで",
          "en": "So stand in for me at the eighty-eight temples. From Temple 1, on foot."
        },
        {
          "id": "p20-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "八十八件ぶん、毎年十日ずつ",
          "en": "One for each of your eighty-eight approvals. Ten days every year."
        },
        {
          "id": "p20-1-4",
          "panel": 1,
          "type": "speech",
          "ja": "へ……？",
          "en": "Huh...?"
        },
