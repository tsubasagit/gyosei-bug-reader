      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "では、行ってまいります",
          "en": "Well then, I'm off."
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "出発の朝。",
          "en": "The morning of departure."
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "不在中は、赤嶺くんが代決を",
          "en": "While I'm away, Akamine signs by proxy.",
          "note": "Daiketsu (signing by proxy): when the person with approval authority is away, a designated substitute approves in their place. What may be approved this way is set by each city's rules."
        },
        {
          "id": "p5-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "重要なものは、私の帰りを待ってください",
          "en": "Anything important waits for my return."
        },
        {
          "id": "p5-2-3",
          "panel": 2,
          "type": "speech",
          "ja": "代決したものは、戻って後閲します",
          "en": "Whatever is signed by proxy, I'll review when I'm back.",
          "note": "Koetsu: the absent manager reviews proxy approvals after returning."
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "お任せください!!",
          "en": "Leave it to me!!"
        },
        {
          "id": "p5-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "お土産は、うどんで!!",
          "en": "Bring back udon!!"
        }
      ]
    },
