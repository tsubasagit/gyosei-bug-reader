        {
          "id": "p9-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "同じころ。讃岐の遍路道。",
          "en": "Meanwhile. A pilgrim path in Sanuki."
        },
        {
          "id": "p9-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "お遍路さん、お接待です",
          "en": "Pilgrim, a little gift for you.",
          "note": "Osettai: the local custom of giving food or drink to pilgrims."
        },
        {
          "id": "p9-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "同行二人ですけん",
          "en": "You never walk alone, you know.",
          "note": "Dogyo ninin, \"two traveling together\": the belief that the monk Kukai walks beside every pilgrim."
        },
        {
          "id": "p9-2-3",
          "panel": 2,
          "type": "speech",
          "ja": "……ありがとうございます",
          "en": "...Thank you very much."
        },
        {
          "id": "p9-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "父さん。続き、始めましたよ",
          "en": "Father. I've picked up where you left off."
        }
      ]
    },
