      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "人事課です。通知はご覧に？",
          "en": "HR here. Did you see our notice?"
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……通知？",
          "en": "...Notice?"
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "課長、今年の年休、0日です",
          "en": "Chief, your paid leave this year: zero days."
        },
        {
          "id": "p2-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "ゼ、0日!?",
          "en": "Z-zero days!?"
        },
        {
          "id": "p2-3-3",
          "panel": 3,
          "type": "speech",
          "ja": "一日も!?",
          "en": "Not even one!?"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "法律の義務ではありません",
          "en": "It's not a legal requirement.",
          "note": "Japan's Labor Standards Act requires employers to make workers take at least 5 days of paid leave a year, but that rule does not apply to local government employees."
        },
        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "でも、課長だけ0日です",
          "en": "But you're the only chief at zero."
        },
        {
          "id": "p2-4-3",
          "panel": 4,
          "type": "speech",
          "ja": "国の調査にも、出ます",
          "en": "And it shows up in the national survey."
        },
        {
          "id": "p2-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "盆栽の水が……係も……",
          "en": "The bonsai needs water... and the unit..."
        },
        {
          "id": "p2-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "休まない理由が、盆栽!?",
          "en": "Your reason for not resting is a bonsai!?"
        }
      ]
    },
