      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "それ、何ですか",
          "en": "What's that?"
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "父の、納経帳です",
          "en": "My father's stamp book.",
          "note": "Nokyocho: a book in which pilgrims collect a red seal and calligraphy at each of the 88 temples of the Shikoku pilgrimage."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "父は四国を、区切り打ちで回っていました",
          "en": "He walked the Shikoku pilgrimage in sections.",
          "note": "Kugiri-uchi: doing the pilgrimage a section at a time instead of all 88 temples in one trip."
        },
        {
          "id": "p3-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "六十五番を打った翌年に、亡くなりまして",
          "en": "He passed away the year after reaching Temple 65."
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "残りは、香川の札所です",
          "en": "What's left are the temples in Kagawa."
        },
        {
          "id": "p3-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "いつか父の続きを、と言いながら……二十年",
          "en": "I kept saying I'd finish it for him someday... for twenty years."
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "課長……",
          "en": "Chief..."
        },
        {
          "id": "p3-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "まとめて十日、取っていただけますか",
          "en": "Could you take ten days, all at once?"
        },
        {
          "id": "p3-4-3",
          "panel": 4,
          "type": "speech",
          "ja": "……十日？",
          "en": "...Ten days?"
        }
      ]
    },
