      "lines": [
        {
          "id": "p10-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "すみません、子ども食堂の者です",
          "en": "Excuse me, I'm from the children's cafeteria."
        },
        {
          "id": "p10-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "公民館の使用料の減免、まだでしょうか",
          "en": "Has our community hall fee waiver gone through yet?"
        },
        {
          "id": "p10-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "減免？",
          "en": "Waiver?"
        },
        {
          "id": "p10-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "子ども食堂の応援は、うちの係の担当です",
          "en": "Supporting the children's cafeteria is our unit's job."
        },
        {
          "id": "p10-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "毎月、前と同じ内容で出ています",
          "en": "It's the same request every month."
        },
        {
          "id": "p10-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "土曜の分が払えないと",
          "en": "If we can't cover Saturday's fee..."
        },
        {
          "id": "p10-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "今週は、開けないんです",
          "en": "we can't open this week."
        },
        {
          "id": "p10-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "泣かれると、こたつで寝れねえ……",
          "en": "If she cries, I can't nap in the kotatsu..."
        },
        {
          "id": "p10-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "おれが課長だ。押しゃ済む!!",
          "en": "I'm the chief. One stamp and it's done!!"
        }
      ]
    },
