        {
          "id": "p8-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "小僧、起案書を書け!! 一件百円!!",
          "en": "Kid, write me proposals!! 100 yen each!!"
        },
        {
          "id": "p8-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "一件百円。請けます",
