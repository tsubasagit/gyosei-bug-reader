      "lines": [
        {
          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "本庁の研修に、私が!?",
          "en": "Me, at HQ training!?"
        },
        {
          "id": "p6-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "本庁に戻る、足がかり……!!",
          "en": "A foothold back to HQ...!!"
        },
        {
          "id": "p6-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "その日の午後。",
          "en": "That afternoon."
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "明日から一週間……ってことは",
          "en": "A week starting tomorrow... which means..."
        },
        {
          "id": "p6-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "代決の、二番目は……",
          "en": "Second in line for proxy is..."
        },
        {
          "id": "p6-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "二番は、テツさんですね",
          "en": "Number two is you, Tetsu."
        },
        {
          "id": "p6-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "……おれ？",
          "en": "...Me?"
        },
        {
          "id": "p6-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "テツ、何も決裁しないで!!",
          "en": "Tetsu, do NOT approve anything!!"
        },
        {
          "id": "p6-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "絶対!!",
          "en": "Ever!!"
        },
        {
          "id": "p6-4-3",
          "panel": 4,
          "type": "speech",
          "ja": "へーい",
          "en": "Yeah, yeah."
        }
      ]
