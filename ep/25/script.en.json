      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "課長のいない、十日間……",
          "en": "Ten days without the chief..."
        },
        {
          "id": "p4-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "それは、天国だァ!!",
          "en": "That's paradise!!"
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "行ってください課長!! 盆栽はおれが!!",
          "en": "Go, Chief!! Leave the bonsai to me!!"
        },
        {
          "id": "p4-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "げ、源田くん……",
          "en": "G-Genda..."
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "水やりは僕が。一日五百円で",
          "en": "I'll do the watering. 500 yen a day."
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "係は私が守ります。課長、どうぞ",
          "en": "I'll protect the unit. Please go, Chief."
        },
        {
          "id": "p4-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "課長不在を仕切れば、本庁への実績……!!",
          "en": "Run things while he's gone, and HQ will notice...!!"
        },
        {
          "id": "p4-4-3",
          "panel": 4,
          "type": "speech",
          "ja": "皆さん……ありがとう",
          "en": "Everyone... thank you."
        }
      ]
    },
