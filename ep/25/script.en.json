          "panel": 2,
          "type": "caption",
          "ja": "翌月。四国・徳島の遍路道。",
          "en": "The next month. A pilgrim path in Tokushima, Shikoku."
        },
        {
          "id": "p20-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "坂、坂、また坂ァ!!",
          "en": "Hill, hill, another hill!!"
        },
        {
          "id": "p20-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "お遍路さん、お接待じょ",
          "en": "Pilgrim, a little gift for ye."
        },
        {
          "id": "p20-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "ありがたや、ありがたや",
          "en": "Bless you, bless you."
