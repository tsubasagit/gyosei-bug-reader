      "lines": [
        {
          "id": "p19-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "ただいま戻りました",
          "en": "I have returned."
        },
        {
          "id": "p19-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "十日目。",
          "en": "Day ten."
        },
        {
          "id": "p19-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "結願しました",
          "en": "I completed the pilgrimage."
        },
        {
          "id": "p19-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……後閲を、いたしましょう",
          "en": "...Now, let me review what was signed."
        },
        {
          "id": "p19-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "それ、テツさんが代決で判を押した一件です",
          "en": "That's one Tetsu stamped by proxy."
