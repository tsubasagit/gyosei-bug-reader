      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "ぐがー……むにゃ……定時……",
          "en": "Zzz... mmh... quitting time..."
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "勤務中に寝るな!! 起きなさい!!",
          "en": "No sleeping on the job!! Wake up!!"
        },
        {
          "id": "p1-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "十月。梨ヶ坂市役所・地下。",
          "en": "October. Nashigasaka City Hall, basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……夢の中では、働いてた",
          "en": "...I was working in my dream."
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "夢の中の分は、時給出ませんよ",
          "en": "Dream hours aren't paid, you know."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "今日も、いい葉の色ですね",
          "en": "Lovely leaf color again today."
        }
      ]
    },
