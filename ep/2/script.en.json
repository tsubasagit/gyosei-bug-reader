      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "小僧、梨ヶ坂の新しい返礼品を考えるぞ!!",
          "en": ""
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "時給分だけですよ",
          "en": ""
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "それ全部、梨ヶ坂で作ってないですよね",
          "en": ""
        },
        {
          "id": "p5-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "返礼品は地元の産品に限るって、国の決まりがあります",
          "en": ""
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "梨ヶ坂で作ってるモンなんて……梨、梨、梨ばっかじゃねーか!!",
          "en": ""
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "決まりがあるなら……抜け道も、必ずある!!",
          "en": ""
        },
        {
          "id": "p5-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "……嫌な予感しかしないわ",
          "en": ""
        }
      ]
    },
