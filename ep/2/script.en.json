        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "寄付は市の歳入よ！職員のあなたに取り分はない!!",
          "en": ""
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "もう聞いてないし!!",
          "en": ""
        },
        {
          "id": "p4-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "ぐふふ……手数料……",
          "en": ""
        }
      ]
