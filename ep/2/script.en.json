      "lines": [
        {
          "id": "p8-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "三割の中から仕入れ値を払ったら、ほとんど残らねえ!!",
          "en": ""
        },
        {
          "id": "p8-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "市内で受ける体験も、地場産品になる……",
          "en": ""
        },
        {
          "id": "p8-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "仕入れゼロの返礼品……おれだ!!",
          "en": ""
        },
        {
          "id": "p8-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "見出しは『絶対定時に帰る方法』",
          "en": ""
        },
        {
          "id": "p8-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "疲れた会社員に刺さりますよ",
          "en": ""
        },
        {
          "id": "p8-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "あっそうだ。せっかくなので、職員であることも書いておこう",
          "en": ""
        },
        {
          "id": "p8-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "どうせ誰も来ねーよ……",
          "en": ""
        },
        {
          "id": "p8-5-2",
          "panel": 5,
          "type": "caption",
          "ja": "掲載初日の申し込みは0件。テツはふて寝した。",
          "en": ""
        },
        {
          "id": "p8-5-3",
          "panel": 5,
          "type": "speech",
          "ja": "え？どういうこと？",
          "en": ""
        },
        {
          "id": "p8-5-4",
          "panel": 5,
          "type": "speech",
          "ja": "定時帰り必達！",
          "en": ""
        },
        {
          "id": "p8-5-5",
          "panel": 5,
          "type": "caption",
          "ja": "その夜、見出しが全国に拡散した。",
          "en": ""
        },
        {
          "id": "p8-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "テツ!!　この人たち、全員あなたの返礼待ち!?",
          "en": ""
        },
        {
          "id": "p8-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "一日体験まだー!?",
          "en": ""
        },
        {
          "id": "p8-6-3",
          "panel": 6,
          "type": "caption",
          "ja": "そして、体験当日。",
          "en": ""
        }
      ]
