      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "自販機の釣り銭口、全部回って……三十円",
          "en": "Hit every vending machine change slot in the building... thirty yen."
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "一月。梨ヶ坂市役所・地下。",
          "en": "January. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "職員が釣り銭口あさるなァ!!",
          "en": "A city employee does NOT dig through change slots!!"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "caption",
          "ja": "流行を行政に取り込む……はずの、特務トレンド係。",
          "en": "The Special Trends Unit... supposedly here to bring trends into government."
        },
        {
          "id": "p1-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "十円をなめる奴は、十円に泣くんだよ",
          "en": "Sneer at ten yen, and ten yen'll make you cry."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "総務課、情報公開請求でパンクしてるそうです",
          "en": "General Affairs is drowning in information disclosure requests, apparently.",
          "note": "Under Japan's freedom of information rules, anyone can ask a city to hand over its internal documents, and the city must decide what to release by a set deadline."
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "地下には関係ねえな",
          "en": "Not the basement's problem."
        }
      ]
    },
