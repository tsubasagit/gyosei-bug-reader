      "lines": [
        {
          "id": "p11-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "情報政策課ですか。ページ、係で預かります",
          "en": "Information Policy Division? Our unit will take charge of the pages."
        },
        {
          "id": "p11-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "オープン……データ……？",
          "en": "Open... data...?",
          "note": "Open data: government data posted online for anyone to use freely. Japan's national guidelines keep anything that identifies individuals out of it."
        },
        {
          "id": "p11-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "では、担当は赤嶺くんということで",
          "en": "Then, Akamine will be in charge."
        },
        {
          "id": "p11-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……え、私？",
          "en": "...Wait, me?"
        },
        {
          "id": "p11-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "一ファイル十円。ツケておきます",
          "en": "Ten yen per file. I'll put it on your tab."
        },
        {
          "id": "p11-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "予算! 契約! 統計! 公開ィィ!!",
          "en": "Budgets! Contracts! Statistics! PUBLISHED!!"
        },
        {
          "id": "p11-6-2",
          "panel": 6,
          "type": "caption",
          "ja": "――一週間で、二千ファイル。",
          "en": "Two thousand files in one week."
        }
      ]
    },
