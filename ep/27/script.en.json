          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "情報公開請求が、何箱も……",
          "en": "Disclosure requests... box after box of them..."
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "人事課に『人が余ってるのは地下だ』と……!!",
          "en": "Personnel said, “The spare hands are all in the basement”...!!"
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "わかりました……私どもで、お引き受けします",
          "en": "I understand... We will take this on."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "余ってねえ!! 十円数えてんだ!!",
          "en": "We ain't spare!! I'm countin' ten-yen coins here!!"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……この部屋のどこに、段ボールを置くのよ",
          "en": "...And where in this room are we putting the boxes?"
        }
      ]
    },
