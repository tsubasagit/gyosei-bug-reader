          "id": "p1-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "住民票か。1枚だな",
          "en": "A resident certificate? Just one sheet."
        },
        {
          "id": "p1-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "きょうから、Xで全部すむぞ!!",
          "en": "Starting today, you can do it all on X!!"
        },
        {
          "id": "p1-1-4",
          "panel": 1,
          "type": "speech",
          "ja": "ここから20枚、めくれ!!",
          "en": "Now swipe through all 20!!"
        }
      ]
