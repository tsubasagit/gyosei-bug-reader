        {
          "id": "p2-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "念じろ。届く",
          "en": "Just will it. It'll get there."
        },
        {
          "id": "p2-1-4",
          "panel": 1,
          "type": "speech",
          "ja": "……届きません。次へどうぞ",
          "en": "...It won't. Next, please."
        },
        {
          "id": "p2-1-5",
          "panel": 1,
          "type": "caption",
          "ja": "画像なので、書けない。",
          "en": "It's an image, so you can't write on it."
        }
      ]
    },
