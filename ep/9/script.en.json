          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "着物も、右前。右を先に",
          "en": "The kimono too: right-front. Right side first."
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "腰紐は骨盤のあたり。結び目は、正面から少しずらして",
          "en": "Waist cord at the hips. Knot a little off-center."
        },
        {
          "id": "p6-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "おれにも帯をやらせろ!!",
          "en": "Let me do the obi too!!"
        },
        {
          "id": "p6-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "あーれー!!",
          "en": "Aaaah, stop!!"
        },
        {
          "id": "p6-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "回さないの",
          "en": "No spinning."
        },
        {
          "id": "p6-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "……苦しい。でも、きれい",
          "en": "...It's tight. But it's beautiful."
        }
      ]
    },
