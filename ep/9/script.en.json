      "lines": [
        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "歩くときは、小股で、内股ぎみに",
          "en": "When you walk, small steps, toes slightly in."
        },
        {
          "id": "p7-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "こう？",
          "en": "Like this?"
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "大股は、裾が割れます",
          "en": "Big strides split the hem open."
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "階段は裾を軽く持って。座るときは、裾をおさえて",
          "en": "On stairs, lift the hem a little. Hold it down when you sit."
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "物を取るときは、袖口をおさえます",
          "en": "When reaching for things, hold your sleeve cuff."
        },
        {
          "id": "p7-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "おれも羽織ってみたぜ!",
          "en": "I tried on a haori too!"
        },
        {
          "id": "p7-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "あっ",
          "en": "Oops."
        },
        {
          "id": "p7-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "テツさん、袖、お茶に入ってます",
          "en": "Tetsu, your sleeve's in the tea."
        }
      ]
    },
