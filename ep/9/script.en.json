        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "カイロ、一枚十円です",
          "en": "Hand warmers, ten yen each."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "着物って、暖かいらしいぞ!!",
          "en": "Kimono are warm, they say!!"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "……あんた、着られるの？",
          "en": "...Can you even put one on?"
        },
        {
          "id": "p1-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "着方は知らねえ!!",
          "en": "No clue how!!"
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "ごめんくださいまし",
          "en": "Pardon me, is anyone here?"
        }
      ]
    },
