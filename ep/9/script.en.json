      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "観光課に伺いましたら、予算がないと……",
          "en": "I asked at Tourism, but they said there's no budget..."
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "地下に、流行を扱う係があると聞きまして",
          "en": "They told me a unit in the basement handles trends."
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "ええ、流行。おれの係です",
          "en": "Trends? That's my unit."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "観光課の実績……本庁に届く……!",
          "en": "A win for Tourism... it'll reach the main building...!"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "十一月十五日は、きものの日ですから",
          "en": "November 15th is Kimono Day, after all.",
          "note": "Kimono Day (November 15) was started by the kimono industry to get people wearing kimono; it falls in the Shichi-Go-San season."
        }
      ]
    },
