        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "caption",
          "ja": "梨ヶ坂商店街。呉服店「きもの まつのや」。",
          "en": "Nashigasaka Shopping Street. Kimono shop \"Matsunoya.\""
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "く、くせえ……",
          "en": "Wh-what's that stink..."
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "樟脳です。虫がつかないように",
          "en": "Camphor. It keeps the moths away."
        },
        {
          "id": "p4-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "見るより、着てごらんなさい",
          "en": "Rather than look, why not try one on?"
        },
        {
          "id": "p4-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "私がやります!　観光課の実績のために!",
          "en": "I'll do it! For Tourism's track record!"
        }
      ]
    },
