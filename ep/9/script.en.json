        {
          "id": "p10-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "貸すたびに洗う……丸洗いは一枚数千円!?",
          "en": "Wash after every rental... a pro cleaning is thousands per kimono!?"
        },
        {
          "id": "p10-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "専門店に二百枚出したら、儲けが消える!!　自分で覚えて洗う!!",
          "en": "Send 200 to a pro and the profit's gone!! I'll learn to wash 'em myself!!"
        },
        {
          "id": "p10-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "――その夜。",
          "en": "That night."
        },
        {
          "id": "p10-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "洗える着物は、ネットに入れて、ドライコース!!",
          "en": "Washable kimono: in a laundry net, on the dry cycle!!"
        },
        {
          "id": "p10-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "おしゃれ着洗剤で、陰干し!!",
          "en": "Delicates detergent, dry in the shade!!"
        },
        {
          "id": "p10-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "絹は、家で洗うと縮む。専門店の丸洗いだ",
          "en": "Silk shrinks if you wash it at home. That's for a pro cleaner."
        },
        {
          "id": "p10-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……テツ、ちゃんと合ってる……",
          "en": "...Tetsu's actually getting it right..."
        }
      ]
    },
