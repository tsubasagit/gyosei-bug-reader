      "lines": [
        {
          "id": "p9-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "眠ってる着物は、全部おれの在庫だ!!",
          "en": "Every sleeping kimono is MY inventory!!"
        },
        {
          "id": "p9-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "一人五千円!!　三百人で……百五十万!!",
          "en": "5,000 yen a head!! Times 300... 1.5 million!!"
        },
        {
          "id": "p9-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "着付け一件、三百円でどうですか",
          "en": "How about 300 yen per dressing?"
        },
        {
          "id": "p9-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "ちょっと待って、預かり物を貸すのは……",
          "en": "Wait, renting out things held in trust is..."
        },
        {
          "id": "p9-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "観光課、三百人だぞ",
          "en": "That's 300 people for Tourism."
        },
        {
          "id": "p9-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "三百人……本庁……",
          "en": "Three hundred... the main building..."
        }
      ]
    },
