      "lines": [
        {
          "id": "p6-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "漏れるのはな、バラバラに置いとくからだ",
          "en": "Stuff leaks 'cause it's scattered all over."
        },
        {
          "id": "p6-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……は？",
          "en": "...Huh?"
