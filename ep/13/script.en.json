      "lines": [
        {
          "id": "p4-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "はい、桑原……",
          "en": "Hello, Kuwabara..."
        },
        {
          "id": "p4-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "あなたの情報が漏れています",
          "en": "Your information has been leaked."
        },
        {
          "id": "p4-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "削除の手数料を――",
          "en": "For a small deletion fee--"
        },
        {
          "id": "p4-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "梨ヶ坂市役所の地下だ",
          "en": "This is the basement of Nashigasaka City Hall."
        },
        {
          "id": "p4-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "ばあちゃんに、二度とかけてくんな",
          "en": "Don't you EVER call Granny again."
        },
        {
          "id": "p4-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "べ、別に。商売敵を追っ払っただけだ",
          "en": "N-no big deal. Just chased off a rival."
        },
        {
          "id": "p4-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "『削除します』は、便乗の詐欺です",
          "en": "\"We'll delete it\" is a piggyback scam.",
          "note": "After big leak news, scammers often call victims offering to \"delete\" their leaked data for a fee. It's always a scam."
        },
        {
          "id": "p4-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "お金の話が出たら、切る",
          "en": "If money comes up, hang up."
        }
      ]
    },
