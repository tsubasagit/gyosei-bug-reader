      "lines": [
        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "地下金庫、あいてます!!",
          "en": "The Underground Vault is open!!"
        },
        {
          "id": "p7-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "漏れるのが怖い紙は、ぜんぶ地下へ",
          "en": "Scared of leaks? Bring your papers below!"
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "これで、ぐっすり眠れるよ",
          "en": "Now I can sleep soundly."
