        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "ばあちゃん。あるぜ",
          "en": "Granny. I've got just the place."
        },
        {
          "id": "p5-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "市役所でいちばん固い場所が!!",
          "en": "The most secure spot in City Hall!!"
        },
        {
          "id": "p5-3-3",
          "panel": 3,
          "type": "speech",
          "ja": "……物置ですよ、そこ",
          "en": "...That's a storeroom."
        }
      ]
