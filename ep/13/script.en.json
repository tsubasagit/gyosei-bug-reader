      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "おっかないねえ……",
          "en": "Scary times, huh..."
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "ここが、流行りの係かい",
          "en": "So this is the trendy unit?"
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "市民課の窓口で、震えておられたので",
          "en": "She was trembling at the Residents' Desk."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "ばあちゃん、それ梨ゼリーの缶だろ!?",
          "en": "Granny, that's a pear jelly tin, right!?"
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "三十年分の、お客さんの伝票だよ",
          "en": "Thirty years of my customers' shipping slips."
        },
        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "……ゼリーじゃなかった",
          "en": "...Not jelly."
        },
        {
          "id": "p2-4-3",
          "panel": 4,
          "type": "speech",
          "ja": "(個人情報の、缶詰……!)",
          "en": "(A tin full of personal data...!)"
        }
      ]
    },
