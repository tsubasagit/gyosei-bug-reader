          "type": "speech",
          "ja": "銀行と、同じ理屈……？",
          "en": "Same logic as a bank...?"
        },
        {
          "id": "p6-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "預かり料は？",
          "en": "What's the fee?"
        },
        {
          "id": "p6-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "一箱三百円。預け放題だ",
          "en": "300 yen a box. No limit!"
        }
      ]
