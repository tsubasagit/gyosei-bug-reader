      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "秋は梨を、全国に送るんだよ",
          "en": "Every fall I ship pears all over Japan."
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "伝票の控えを、三十年とってある",
          "en": "I've kept the slip copies for thirty years."
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "あたしの免許証のコピーも。もう返したのにね",
          "en": "Copies of my license too. Even though I gave it back."
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "お名前、住所、電話……千人分はありますね",
          "en": "Names, addresses, phone numbers... a thousand people's."
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "(千人分……)",
          "en": "(A thousand...)"
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "ニュースで、漏れたら大ごとだって",
          "en": "The news says a leak is a big deal."
        },
        {
          "id": "p3-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "お客さんに迷惑かけたら、申し訳なくて",
          "en": "I'd hate to cause my customers trouble."
        },
        {
          "id": "p3-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "捨てれば、漏れませんけど",
          "en": "Throw them out and they can't leak."
        },
        {
          "id": "p3-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "捨てられないよ。お得意さんだもの",
          "en": "I can't! They're my regulars."
        }
      ]
    },
