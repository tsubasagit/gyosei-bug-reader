          "panel": 1,
          "type": "speech",
          "ja": "要らない控えは、シュレッダーで……",
          "en": "Slips you don't need, shred them..."
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "お客さんの名前を、刻むなんてできないよ",
          "en": "I could never shred my customers' names."
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "今日から一週間、研修で留守にします",
          "en": "I'll be away at training for a week."
        },
        {
          "id": "p5-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "桑原さんを、頼みます",
          "en": "Please look after Mrs. Kuwabara."
