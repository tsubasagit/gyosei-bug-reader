      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "飲食チェーンのアプリで、会員情報が流出",
          "en": "A restaurant chain's app leaked its members' data."
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "およそ一千万件。ほぼ全会員です",
          "en": "About ten million records. Nearly every member."
        },
        {
          "id": "p1-1-3",
          "panel": 1,
          "type": "speech",
          "ja": "お、おれの焼肉の会員情報がァ!!",
          "en": "M-my yakiniku membership info!!"
        },
        {
          "id": "p1-1-4",
          "panel": 1,
          "type": "caption",
          "ja": "十月。梨ヶ坂市役所・地下。",
          "en": "October. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "登録名『肉の帝王』。漏れて困る？",
          "en": "Your username's \"Meat Emperor.\" So what?"
        },
        {
          "id": "p1-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "……恥ずかしいだろ",
          "en": "...The shame!"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "先月はカーシェアで、約六百六十万件",
          "en": "Last month, a car-share leaked about 6.6 million."
        },
        {
          "id": "p1-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "やめた人の、免許証の画像まで",
          "en": "Even ex-members' driver's license photos."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "なんで最近、こんなに多いんだ？",
          "en": "Why are there so many lately?"
        },
        {
          "id": "p1-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "四年前の春から、国への届け出が義務に",
          "en": "Four springs ago, reporting leaks to the government became mandatory.",
          "note": "Since April 2022, Japan's Act on the Protection of Personal Information requires businesses to report serious data leaks to the Personal Information Protection Commission."
        },
        {
          "id": "p1-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "数が、表に出ました",
          "en": "So now the numbers show."
        },
        {
          "id": "p1-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "アプリは何百万人分を、一か所に持ってます",
          "en": "Apps keep millions of people's data in one place."
        },
        {
          "id": "p1-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "一度破られたら、全員分です",
          "en": "Break in once, and you get everyone."
        },
        {
          "id": "p1-6-3",
          "panel": 6,
          "type": "speech",
          "ja": "おれの肉の帝王も、一千万分の一か……",
          "en": "My Meat Emperor... one in ten million..."
        }
      ]
    },
