      "lines": [
        {
          "id": "p17-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "情報政策課の錠島です",
          "en": "Jojima, Information Policy Division."
        },
        {
          "id": "p17-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "市が預かった時点で、市の個人情報です",
          "en": "Once the city took it, it's the city's personal data.",
          "note": "Once a city office takes custody of documents containing personal data, the city is legally responsible for them, including any leak."
        },
        {
          "id": "p17-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "市が持っていいのは、仕事に必要な分だけ",
          "en": "The city may only hold what its work requires.",
          "note": "Japanese law lets government bodies hold personal information only to the extent needed for their official duties."
        },
        {
          "id": "p17-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "法律で、決まっています",
          "en": "That's the law."
        },
        {
          "id": "p17-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "……預かるのは、市の仕事じゃない",
          "en": "...Storing papers isn't city work."
        },
        {
          "id": "p17-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "百人を超えたら、国の委員会に報告です",
          "en": "Over 100 people means a report to the national commission.",
          "note": "Leaks affecting over 100 people must be reported to the Personal Information Protection Commission, and the affected people must be notified."
        },
        {
          "id": "p17-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "ご本人にも、お知らせを",
          "en": "And we must notify each person."
        },
        {
          "id": "p17-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "で、でもよ。漏れるってのは",
          "en": "B-but a leak means"
        },
        {
          "id": "p17-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "悪いやつが、盗むことだろ!?",
          "en": "some crook stealing it, right!?"
        },
        {
          "id": "p17-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "盗まれるだけじゃ、ありません",
          "en": "Theft isn't the only way."
        }
      ]
    },
