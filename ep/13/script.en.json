        {
          "id": "p7-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "毎度。……三百円な",
          "en": "Thanks. ...That's 300 yen."
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "(市民の不安に、市が応える……本庁が見るわ!)",
          "en": "(Easing citizens' worries... the main building will notice!)"
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "僕は二割で",
          "en": "I'll take 20%."
        },
        {
          "id": "p7-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "孫がね、何でもコピー取っとけって",
          "en": "My grandson says copy everything."
        },
        {
          "id": "p7-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "コピーも預け放題だ",
          "en": "Copies store free too!"
        },
        {
          "id": "p7-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "(……紙って、増えるのね)",
          "en": "(Paper breeds...)"
        }
      ]
