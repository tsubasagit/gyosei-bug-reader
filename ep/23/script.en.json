    {
     "id": "p2-1-1",
     "panel": 1,
     "type": "speech",
     "ja": "5階の若いの。来週の日曜、ベンチに座ってくれ",
     "en": "Young man on the fifth floor. Sit on our bench next Sunday."
    },
    {
     "id": "p2-1-2",
     "panel": 1,
     "type": "speech",
     "ja": "30番の監督が、腰をやってのう。代理はわしじゃ",
     "en": "Number 30, our manager, threw out his back. I'm filling in."
    },
    {
     "id": "p2-2-1",
     "panel": 2,
     "type": "speech",
     "ja": "日曜は昼寝の日だ",
     "en": "Sunday is nap day."
    },
    {
     "id": "p2-3-1",
     "panel": 3,
     "type": "speech",
     "ja": "団地で若いのは、お前だけじゃ",
     "en": "You're the only young man in this complex."
    },
    {
     "id": "p2-3-2",
     "panel": 3,
     "type": "speech",
     "ja": "肩は町一番なんじゃが、捕れんのじゃ",
     "en": "His arm is the best in town, but he can't catch."
    },
    {
     "id": "p2-5-1",
     "panel": 5,
     "type": "speech",
     "ja": "どうせおれ、控えだし",
     "en": "I'm just a backup anyway."
    },
    {
     "id": "p2-5-2",
     "panel": 5,
     "type": "speech",
     "ja": "なおさら行かねえ!!",
     "en": "All the more reason I'm not going!!"
    }
   ]
  },
