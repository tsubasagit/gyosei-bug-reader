     "id": "p4-1-1",
     "panel": 1,
     "type": "speech",
     "ja": "じいさん、ベンチ、引き受けた",
     "en": "Old man, I'll take the bench."
    },
    {
     "id": "p4-2-1",
     "panel": 2,
     "type": "speech",
     "ja": "急にどうした",
     "en": "What's got into you all of a sudden?"
    },
    {
     "id": "p4-2-2",
     "panel": 2,
     "type": "speech",
     "ja": "それ、何回目？",
     "en": "How many times is that now?"
    },
    {
     "id": "p4-3-1",
     "panel": 3,
     "type": "speech",
     "ja": "小僧、データ班だ!!",
     "en": "Kid, you're on the data team!!"
