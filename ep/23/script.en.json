     "id": "p4-5-1",
     "panel": 5,
     "type": "speech",
     "ja": "……現金で千円",
     "en": "...A thousand yen in cash."
    },
    {
     "id": "p4-5-2",
     "panel": 5,
     "type": "speech",
     "ja": "現金なら、行きます!!",
     "en": "Cash? I'm in!!"
    },
    {
     "id": "p4-6-1",
     "panel": 6,
     "type": "speech",
     "ja": "では、測ります",
     "en": "Then I'll measure."
    },
    {
     "id": "p4-6-2",
     "panel": 6,
     "type": "caption",
     "ja": "一時間後。",
     "en": "One hour later."
    }
   ]
