      "lines": [
        {
          "id": "p2-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "AI利用料が予算の三倍。三割削れ、と",
          "en": "AI fees: triple the budget. Cut 30%."
        },
        {
          "id": "p2-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "問い合わせの返事が遅い、と苦情も",
          "en": "And complaints about slow replies."
        },
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "一位は……源田くんです",
          "en": "The top user is... Genda."
        },
