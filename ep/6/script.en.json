        {
          "id": "p4-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "字数で、金かかってたのか!!",
          "en": "I was paying by the WORD?!"
        },
        {
          "id": "p4-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "どっちが上じゃない。得意が違うの!",
          "en": "Neither one is better. They're good at different things!"
        }
      ]
