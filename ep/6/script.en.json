        {
          "id": "p2-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "課長、知ってます?",
          "en": "Chief, you know it?"
        },
        {
          "id": "p2-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "私にも、分かりません",
          "en": "I'm afraid I don't know either."
        }
      ]
