      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "今週SNSで話題のAIです",
          "en": "The AI everyone's posting about this week."
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "知らないの!? よく聞きなさい!",
          "en": "You don't know?! Listen up!"
        },
        {
          "id": "p3-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "ChatGPTは『作文』が得意",
          "en": "ChatGPT is great at “essays.”"
        },
        {
          "id": "p3-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "Jevは『マークシート』!",
          "en": "Jev does “bubble sheets”!",
          "note": "Japanese exams often use mark sheets: you just fill in a bubble. Jev likewise returns a choice, a score or a probability — never prose."
        },
        {
          "id": "p3-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "文章書かねえって、それAIか!?",
          "en": "It doesn't write? Is that even AI?!"
        },
        {
          "id": "p3-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "渡すのは二つ。状況と質問だけ!",
          "en": "You give it two things: the situation and a question!"
        },
        {
          "id": "p3-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "質問の型は、たった三つ!",
          "en": "And there are only three types of question!"
        },
        {
          "id": "p3-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "答えが数字だけかよ!?",
          "en": "The answer's just a NUMBER?!"
        },
        {
          "id": "p3-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "だからプログラムがそのまま使えます",
          "en": "So a program can use it right away."
        },
        {
          "id": "p3-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "選ぶ、点数、はいの確率……",
          "en": "Pick one, score, chance of yes..."
        }
      ]
    },
