      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "テツさん、さっきから何やってるんですか",
          "en": "Tetsu, what are you even doing over there?"
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "見ろ、このAIの使いこなしを!!",
          "en": "Behold! A true master of AI!!"
        },
        {
          "id": "p1-1-3",
          "panel": 1,
          "type": "caption",
          "ja": "九月。梨ヶ坂市役所・地下。",
          "en": "September. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "『本日の遅刻は、やむを得ぬ家庭の事情により』!!",
          "en": "“Today's lateness: unavoidable family matters”!!"
        },
        {
          "id": "p1-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "あんた独身でしょ!!",
          "en": "You're SINGLE!!"
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "3,812番か……",
          "en": "Number 3,812, huh..."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "ちょっと、聞いてる!? あんたも仕事中よ!",
          "en": "Hey, are you listening?! You're on the clock too!"
        }
      ]
    },
