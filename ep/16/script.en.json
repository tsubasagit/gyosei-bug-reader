      "lines": [
        {
          "id": "p1-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "起きなさい、テツ!! 通知よ!!",
          "en": "Wake up, Tetsu!! There's a notice!!"
        },
        {
          "id": "p1-1-2",
          "panel": 1,
          "type": "caption",
          "ja": "十月。スポーツの秋。梨ヶ坂市役所・地下。",
          "en": "October. Sports season. Nashigasaka City Hall, the basement."
        },
        {
          "id": "p1-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "課対抗大運動会。職員の健康づくり",
          "en": "Inter-Section Sports Day. For staff health."
        },
        {
          "id": "p1-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "全課参加だそうです",
          "en": "Every section is taking part, apparently."
        },
        {
          "id": "p1-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "おれの健康は、昼寝で作られてんだ",
          "en": "My health is built on naps."
        },
        {
          "id": "p1-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "運動会ですか。懐かしいですね",
          "en": "A sports day? How nostalgic."
        },
        {
          "id": "p1-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "地下は棄権だ、棄権",
          "en": "The basement's opting out. Opting out."
        }
      ]
    },
