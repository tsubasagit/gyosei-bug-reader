      "lines": [
        {
          "id": "p3-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "優勝した課は、庁舎の空き部屋を選べるの",
          "en": "The winning section gets to pick any empty room in the building."
        },
        {
          "id": "p3-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "最上階は、私たちがいただくわ",
          "en": "We'll be taking the top floor."
