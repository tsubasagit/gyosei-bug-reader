      "lines": [
        {
          "id": "p9-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "第一種目、書類の山リレー!!",
          "en": "Event one: Paper Mountain Relay!!"
        },
        {
          "id": "p9-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "毎日、書類の山を枕にしてんだ……匂いで分かる!!",
          "en": "I sleep on mountains of paper every day... I can tell by smell!!"
        },
        {
          "id": "p9-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "こいつは右!! こいつは左ィ!!",
          "en": "This one goes right!! This one goes left!!"
        },
        {
          "id": "p9-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "転入届は市民課、道路の穴は道路課!!",
          "en": "Moving-in notice: Residents' Section! Pothole: Roads Section!!",
          "note": "In a Japanese city hall, each kind of paperwork has its own section: a moving-in notice goes to the residents' section, road damage to the roads section. Section names and divisions vary by city."
        },
        {
          "id": "p9-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "……うちの課に、欲しい",
          "en": "...I want him in my section."
        },
        {
          "id": "p9-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "モップがけで鍛えた足だよ!!",
          "en": "These legs are trained by mopping!!"
        },
        {
          "id": "p9-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "一種目め。歩合、百円です",
          "en": "Event one done. A hundred yen commission."
        },
        {
          "id": "p9-6-2",
          "panel": 6,
          "type": "speech",
          "ja": "……あのおばさま、地下の職員？",
          "en": "...Is that lady from the basement too?"
        }
      ]
    },
