          "panel": 2,
          "type": "speech",
          "ja": "職員の健康づくりだ。けがのないように",
          "en": "It's for staff health. Mind you don't get hurt."
        },
        {
          "id": "p8-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "……ただし、勝ちたまえ",
          "en": "...But do win."
        },
        {
          "id": "p8-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "企画政策課。全種目、一位を取るわ",
          "en": "Policy Planning. First place in every event."
        },
        {
          "id": "p8-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "対するは地下!! 個性的な顔ぶれだァ!!",
          "en": "Facing them: the Basement!! What a colorful lineup!!"
        },
        {
          "id": "p8-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "角部屋は、おれのもんだァ!!",
          "en": "The corner room is mine!!"
        }
      ]
    },
