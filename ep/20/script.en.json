      "lines": [
        {
          "id": "p5-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "5階は、どこも漏ってます",
          "en": "Every unit on the 5th floor is leaking."
        },
        {
          "id": "p5-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "お年寄りのお部屋から、順番に",
          "en": "Starting with the elderly residents, in order."
        },
        {
          "id": "p5-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "修理は公社……市の仕事じゃ、ない……",
          "en": "Repairs are the housing corporation's job... not the city's..."
        },
        {
          "id": "p5-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "下水道課ですか。5号棟まで……",
          "en": "The Sewer Division? Could you come to Building 5..."
        },
        {
          "id": "p5-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "市の試作品、雨水ろ過ボトルです",
          "en": "The city's prototype. A rain filter bottle."
        },
        {
          "id": "p5-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "災害で水道が止まったら、雨を飲み水に",
          "en": "If the water supply is cut in a disaster, it turns rain into drinking water.",
          "note": "Rain filter bottles like this are portable purifiers for emergencies. They are not meant for everyday business."
        },
        {
          "id": "p5-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "晴れたら、お年寄りに配ります",
          "en": "Once the weather clears, we hand them out to the elderly."
        },
        {
          "id": "p5-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "倉庫も雨漏りで。お宅に",
          "en": "Our storeroom leaks, too. So, your place."
        }
      ]
    },
