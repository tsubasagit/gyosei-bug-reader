        {
          "id": "p8-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "副業じゃねえ!! 市の『雨水活用』だ!!",
          "en": "It's not a side job!! It's the city's \"rainwater project\"!!"
        },
        {
          "id": "p8-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "おれの部屋だけじゃ足りねえ。雨、一杯十円で買う",
          "en": "My room alone isn't enough. I'll buy rain, ten yen a cup."
        },
        {
          "id": "p8-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "……そうかしら",
          "en": "...Is that so?"
        },
        {
          "id": "p8-4-2",
          "panel": 4,
          "type": "speech",
          "ja": "ラベルと通販、一本二十円で乗ります",
          "en": "Labels and online sales, I'm in at twenty yen a bottle."
        }
      ]
    },
