        {
          "id": "p7-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "雨を通せば、天然水じゃねえか!!",
          "en": "Run rain through a filter and it's natural water, isn't it!!",
          "note": "Natural water (natural mineral water) is groundwater from a specific source. Rain caught from the sky is not natural water."
        },
        {
          "id": "p7-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "……雨は、タダで降ってくる商品だ",
          "en": "...Rain is a product that falls for free."
        },
        {
          "id": "p7-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "バケツ一杯で二十本、三千円",
          "en": "Twenty bottles per bucket. That's 3,000 yen."
        },
        {
          "id": "p7-3-2",
          "panel": 3,
          "type": "speech",
          "ja": "……原価、ゼロですね",
          "en": "...The cost is zero."
        },
        {
          "id": "p7-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "公務員が雨を売るなんて、副業でしょ!!",
          "en": "A civil servant selling rain is a side job!!"
        },
        {
          "id": "p7-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "見ろ。在庫は、空から無限だ",
          "en": "Look. My stock is unlimited, straight from the sky."
        }
      ]
