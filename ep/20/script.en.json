        {
          "id": "p8-1-1",
          "panel": 1,
          "type": "speech",
          "ja": "「災害のときに、雨を飲み水に」。試作品だそうです",
          "en": "\"In a disaster, turn rain into drinking water.\" Apparently it's a prototype."
        },
        {
          "id": "p8-1-2",
          "panel": 1,
          "type": "speech",
          "ja": "ほら。配る分よ",
          "en": "Here. Your share."
        },
        {
          "id": "p8-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "毎日が、災害級の雨だ!!",
          "en": "Every day is a disaster-level rain!!"
        },
        {
          "id": "p8-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "今使わねえで、いつ使う",
          "en": "If we don't use it now, when do we?"
