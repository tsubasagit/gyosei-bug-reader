      "lines": [
        {
          "id": "p2-2-1",
          "panel": 2,
          "type": "speech",
          "ja": "防水は、乾いてからでないと工事できません",
          "en": "We can't waterproof until it dries."
        },
        {
          "id": "p2-2-2",
          "panel": 2,
          "type": "speech",
          "ja": "いま、四十軒待ちです",
          "en": "There are forty waiting right now."
        },
        {
          "id": "p2-3-1",
          "panel": 3,
          "type": "speech",
          "ja": "……四十軒",
          "en": "...Forty."
        },
        {
          "id": "p2-4-1",
          "panel": 4,
          "type": "speech",
          "ja": "部屋の番って名目で、休めるじゃねえか!!",
          "en": "\"Guarding my room\" counts as an excuse to rest, doesn't it!!"
        },
        {
          "id": "p2-5-1",
          "panel": 5,
          "type": "speech",
          "ja": "部屋の番、ですか。源田くんの部屋が心配です",
          "en": "Guarding his room, is it? I do worry about Genda's apartment."
        },
        {
          "id": "p2-5-2",
          "panel": 5,
          "type": "speech",
          "ja": "赤嶺くんに、合羽を届けてもらいましょう",
          "en": "Let's have Akamine bring him a raincoat."
        },
        {
          "id": "p2-6-1",
          "panel": 6,
          "type": "speech",
          "ja": "……やった、休める",
          "en": "...Yes! A day off."
        }
      ]
    },
